<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gölge -->
    <item>
        <shape>
            <corners android:radius="28dp"/>
            <solid android:color="#081B32"/>
        </shape>
    </item>

    <!-- İç katman -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">

        <shape>

            <corners android:radius="26dp"/>

            <gradient
                android:startColor="#153A66"
                android:centerColor="#0D2748"
                android:endColor="#091C35"
                android:angle="270"/>

            <stroke
                android:width="1dp"
                android:color="#2E5E95"/>

        </shape>

    </item>

</layer-list>