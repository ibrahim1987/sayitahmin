<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_history_row_modern"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Tahmin Edilen Sayı Hücreleri -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGuess1"
            style="@style/GuessDigitStyle"
            android:text="1" />

        <TextView
            android:id="@+id/tvGuess2"
            style="@style/GuessDigitStyle"
            android:layout_marginStart="6dp"
            android:text="5" />

        <TextView
            android:id="@+id/tvGuess3"
            style="@style/GuessDigitStyle"
            android:layout_marginStart="6dp"
            android:text="8" />
    </LinearLayout>

    <!-- Geri Bildirim Sonuç Hücreleri (+, -, x) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResult1"
            style="@style/GuessResultStyle"
            android:text="+" />

        <TextView
            android:id="@+id/tvResult2"
            style="@style/GuessResultStyle"
            android:layout_marginStart="6dp"
            android:text="+" />

        <TextView
            android:id="@+id/tvResult3"
            style="@style/GuessResultStyle"
            android:layout_marginStart="6dp"
            android:text="-" />
    </LinearLayout>

</LinearLayout>