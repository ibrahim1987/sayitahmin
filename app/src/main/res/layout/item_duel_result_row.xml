<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_duel_result_card"
    android:elevation="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvResultEmoji"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_rank_badge"
        android:gravity="center"
        android:text="🏆"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Kazanan"
        android:textColor="#1976F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Düello tamamlandı"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResultSubMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Sayı: 123"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

</LinearLayout>