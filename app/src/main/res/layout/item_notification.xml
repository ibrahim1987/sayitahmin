<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_main_card"
    android:padding="14dp">

    <ImageView
        android:id="@+id/imgNotificationIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_icon_soft"
        android:padding="11dp"
        android:src="@drawable/ic_notifications"
        android:contentDescription="Bildirim"
        app:tint="@color/primary_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNotificationTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:text="Yarın Matematik sınavın var"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/imgNotificationIcon"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteNotification"
        app:layout_constraintTop_toTopOf="@id/imgNotificationIcon" />

    <TextView
        android:id="@+id/tvNotificationMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:text="Sınav hazırlığını kontrol etmeyi unutma."
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/imgNotificationIcon"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteNotification"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationTitle" />

    <TextView
        android:id="@+id/tvNotificationDate"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_icon_soft"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Bugün"
        android:textColor="@color/primary_blue"
        android:textSize="11sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/imgNotificationIcon"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationMessage" />

    <ImageView
        android:id="@+id/btnDeleteNotification"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Sil"
        app:tint="@color/text_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>