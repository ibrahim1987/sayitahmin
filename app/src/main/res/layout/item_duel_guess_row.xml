<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_history_row_modern"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">



    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="İbrahim"
            android:textColor="#09265A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="14:32"
            android:textColor="#6B819D"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGuess1"
            style="@style/GuessDigitStyle"
            android:text="1" />

        <TextView
            android:id="@+id/tvGuess2"
            style="@style/GuessDigitStyle"
            android:layout_marginStart="6dp"
            android:text="5" />

        <TextView
            android:id="@+id/tvGuess3"
            style="@style/GuessDigitStyle"
            android:layout_marginStart="6dp"
            android:text="8" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResult1"
            style="@style/GuessResultStyle"
            android:background="@drawable/bg_result_green"
            android:text="+"
            android:textColor="#1B8E24" />

        <TextView
            android:id="@+id/tvResult2"
            style="@style/GuessResultStyle"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_result_green"
            android:text="+"
            android:textColor="#1B8E24" />

        <TextView
            android:id="@+id/tvResult3"
            style="@style/GuessResultStyle"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_result_orange"
            android:text="-"
            android:textColor="#F59B00" />

    </LinearLayout>

</LinearLayout>