<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hmmi.sto">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">

        <meta-data
            android:name ="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value = "true" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2454119550999139~1276660719"/>

        <!-- Ana Ekran (Düello Başlangıç) -->
        <activity android:name="com.hmmi.guessnumber.DuelMainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Giriş ve Kayıt İşlemleri -->
        <activity android:name="com.hmmi.login.AuthLoginActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.hmmi.login.RegisterActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.hmmi.login.ProfileActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Düello Modülü Aktiviteleri -->
        <activity android:name="com.hmmi.guessnumber.MyDuelActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity android:name="com.hmmi.guessnumber.CreateDuelInviteActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.hmmi.guessnumber.DuelGameActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.hmmi.guessnumber.DuelProfileActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity android:name="com.hmmi.guessnumber.DuelHowToPlayActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />
        <activity android:name="com.hmmi.guessnumber.SingleGameActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />
        <!-- Firebase Bildirim Servisi -->
        <service
            android:name="com.hmmi.guessnumber.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>